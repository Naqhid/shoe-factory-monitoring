group_id = g.id\n        WHERE DATE(mcp.prod_date) BETWEEN '2026-04-07' AND '2026-04-07'\n        GROUP BY DATE(mcp.prod_date), mcp.work_centre_id, c.name, s.name, col.name, l.name, g.name\n        ORDER BY mcp.prod_date, wc.name\n      ","sqlMessage":"Expression #1 of ORDER BY clause is not in GROUP BY clause and contains nonaggregated column 'florence.mcp.prod_date' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by","sqlState":"42000","stack":"Error: Expression #1 of ORDER BY clause is not in GROUP BY clause and contains nonaggregated column 'florence.mcp.prod_date' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by\n    at PromisePool.query (C:\\Software\\shoe-factory-monitoring\\backend\\node_modules\\mysql2\\lib\\promise\\pool.js:36:22)\n    at getHourlyProductionStatus (C:\\Software\\shoe-factory-monitoring\\backend\\src\\controllers\\apiController.js:16:31)\n    at Layer.handle [as handle_request] (C:\\Software\\shoe-factory-monitoring\\backend\\node_modules\\express\\lib\\router\\layer.js:95:5)\n    at next (C:\\Software\\shoe-factory-monitoring\\backend\\node_modules\\express\\lib\\router\\route.js:149:13)\n    at Route.dispatch (C:\\Software\\shoe-factory-monitoring\\backend\\node_modules\\express\\lib\\router\\route.js:119:3)\n    at Layer.handle [as handle_request] (C:\\Software\\shoe-factory-monitoring\\backend\\node_modules\\express\\lib\\router\\layer.js:95:5)\n    at C:\\Software\\shoe-factory-monitoring\\backend\\node_modules\\express\\lib\\router\\index.js:284:15\n    at router.process_params (C:\\Software\\shoe-factory-monitoring\\backend\\node_modules\\express\\lib\\router\\index.js:346:12)\n    at next (C:\\Software\\shoe-factory-monitoring\\backend\\node_modules\\express\\lib\\router\\index.js:280:10)\n    at C:\\Software\\shoe-factory-monitoring\\backend\\src\\app.js:99:3","timestamp":"2026-04-07T05:39:31