# Copy to .env.local and adjust for your setup (not committed).

# Develop: frontend 3000 + backend 3001 (default backend PORT)
VITE_DEV_API_PROXY=http://127.0.0.1:3001

# Feature branch: frontend 3002 + backend 3101 — use this instead on feature worktrees
# VITE_DEV_API_PROXY=http://127.0.0.1:3101

# Alternative: call backend directly (no Vite proxy)
# VITE_API_BASE_URL=http://127.0.0.1:3001
